<?xml version="1.0"?>
<robot name="simple_box">

  <!-- 腰 -->
  <link name="base_link">
    <visual><geometry><box size="0.2 0.14 0.12"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.2 0.1 0.1"/></geometry></collision>
    <inertial><mass value="1.0"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 右腕上 -->
  <link name="armRU">
    <visual><geometry><box size="0.1 0.05 0.05"/></geometry>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.2 0.1 0.05"/></geometry></collision>
    <inertial><mass value="0.2"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 右腕下 -->
  <link name="armRL">
    <visual><geometry><box size="0.1 0.05 0.05"/></geometry>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.2 0.1 0.05"/></geometry></collision>
    <inertial><mass value="0.2"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 左腕上 -->
  <link name="armLU">
    <visual><geometry><box size="0.1 0.05 0.05"/></geometry>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.2 0.1 0.05"/></geometry></collision>
    <inertial><mass value="0.2"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 左腕下 -->
  <link name="armLL">
    <visual><geometry><box size="0.1 0.05 0.05"/></geometry>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.2 0.1 0.05"/></geometry></collision>
    <inertial><mass value="0.2"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 首下 -->
  <link name="neckBottom">
    <visual><geometry><box size="0.05 0.05 0.05"/></geometry>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.05 0.05 0.05"/></geometry></collision>
    <inertial><mass value="0.2"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 首中間 -->
  <link name="neckMid">
    <visual><geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.05 0.05 0.05"/></geometry></collision>
    <inertial><mass value="0.2"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 首上 -->
  <link name="neckTop">
    <visual><geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.05 0.05 0.05"/></geometry></collision>
    <inertial><mass value="0.2"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 頭 -->
  <link name="head">
    <visual><geometry><box size="0.15 0.1 0.1"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.1 0.1 0.1"/></geometry></collision>
    <inertial><mass value="0.5"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 右足腰 -->
  <link name="legBaseR">
    <visual><geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.05 0.05 0.05"/></geometry></collision>
    <inertial><mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 右太もも -->
  <link name="legHutoR">
    <visual><geometry><box size="0.05 0.05 0.1"/></geometry>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.05 0.05 0.1"/></geometry></collision>
    <inertial><mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 右すね -->
  <link name="legSuneR">
    <visual><geometry><box size="0.05 0.05 0.1"/></geometry>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.05 0.05 0.1"/></geometry></collision>
    <inertial><mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 右あし -->
  <link name="footR">
    <visual><geometry><box size="0.025 0.05 0.1"/></geometry>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.05 0.05 0.1"/></geometry></collision>
    <inertial><mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 左足腰 -->
  <link name="legBaseL">
    <visual><geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.05 0.05 0.05"/></geometry></collision>
    <inertial><mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 左太もも -->
  <link name="legHutoL">
    <visual><geometry><box size="0.05 0.05 0.1"/></geometry>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.05 0.05 0.1"/></geometry></collision>
    <inertial><mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 左すね -->
  <link name="legSuneL">
    <visual><geometry><box size="0.05 0.05 0.1"/></geometry>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.05 0.05 0.1"/></geometry></collision>
    <inertial><mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 左あし -->
  <link name="footL">
    <visual><geometry><box size="0.025 0.05 0.1"/></geometry>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><box size="0.05 0.05 0.1"/></geometry></collision>
    <inertial><mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- ===== ジョイント ===== -->

  <!-- 腕（肩のy=±0.095は幅14cm対応） -->
  <joint name="base_to_armRU" type="revolute">
    <parent link="base_link"/><child link="armRU"/>
    <origin xyz="0.05 0.095 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.6" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <joint name="armRU_to_armRL" type="revolute">
    <parent link="armRU"/><child link="armRL"/>
    <origin xyz="0.08 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="-0.2" effort="10" velocity="1.0"/>
  </joint>

  <joint name="base_to_armLU" type="revolute">
    <parent link="base_link"/><child link="armLU"/>
    <origin xyz="0.05 -0.095 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.6" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <joint name="armLU_to_armLL" type="revolute">
    <parent link="armLU"/><child link="armLL"/>
    <origin xyz="0.08 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="-0.2" effort="10" velocity="1.0"/>
  </joint>

  <!-- 首 -->
  <joint name="base_to_neckBottom" type="revolute">
    <parent link="base_link"/><child link="neckBottom"/>
    <origin xyz="0.07 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1" upper="1" effort="10" velocity="1.0"/>
  </joint>

  <joint name="neckBottom_to_neckMid" type="revolute">
    <parent link="neckBottom"/><child link="neckMid"/>
    <origin xyz="0.05 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1" upper="1" effort="10" velocity="1.0"/>
  </joint>

  <joint name="neckMid_to_neckTop" type="revolute">
    <parent link="neckMid"/><child link="neckTop"/>
    <origin xyz="0.05 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6" upper="0.75" effort="10" velocity="1.0"/>
  </joint>

  <joint name="neckTop_to_head" type="revolute">
    <parent link="neckTop"/><child link="head"/>
    <origin xyz="0.05 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="10" velocity="1.0"/>
  </joint>

  <!-- 右足（股関節y=+0.045は幅14cm対応） -->
  <joint name="base_to_legBaseR" type="revolute">
    <parent link="base_link"/><child link="legBaseR"/>
    <origin xyz="-0.05 0.045 -0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785398" upper="0.785398" effort="10" velocity="1.0"/>
  </joint>

  <joint name="legBaseR_to_legHutoR" type="revolute">
    <parent link="legBaseR"/><child link="legHutoR"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="0.75" effort="10" velocity="1.0"/>
  </joint>

  <joint name="legHutoR_to_legSuneR" type="revolute">
    <parent link="legHutoR"/><child link="legSuneR"/>
    <origin xyz="0 0 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.2" upper="1.8" effort="10" velocity="1.0"/>
  </joint>

  <joint name="legSuneR_to_footR" type="revolute">
    <parent link="legSuneR"/><child link="footR"/>
    <origin xyz="0 0 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="-0.2" effort="10" velocity="1.0"/>
  </joint>

  <!-- 左足（股関節y=-0.045は幅14cm対応） -->
  <joint name="base_to_legBaseL" type="revolute">
    <parent link="base_link"/><child link="legBaseL"/>
    <origin xyz="-0.05 -0.045 -0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785398" upper="0.785398" effort="10" velocity="1.0"/>
  </joint>

  <joint name="legBaseL_to_legHutoL" type="revolute">
    <parent link="legBaseL"/><child link="legHutoL"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="0.75" effort="10" velocity="1.0"/>
  </joint>

  <joint name="legHutoL_to_legSuneL" type="revolute">
    <parent link="legHutoL"/><child link="legSuneL"/>
    <origin xyz="0 0 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.2" upper="1.8" effort="10" velocity="1.0"/>
  </joint>

  <joint name="legSuneL_to_footL" type="revolute">
    <parent link="legSuneL"/><child link="footL"/>
    <origin xyz="0 0 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="-0.2" effort="10" velocity="1.0"/>
  </joint>

</robot>

